rules_version = '2';

// Question images for the shared library (see firestore.rules for the whole picture).
//
// Most questions are pictures rather than text, because the College Board export draws equations, graphs and
// tables as graphics. Those images are too big for Firestore documents, so they live here in Cloud Storage
// while the question text and the answer keys stay in Firestore.
//
// Membership is read from the same two Firestore collections, so there is one place to invite somebody and it
// governs both halves of the library. Storage rules can query Firestore directly, which is what firestore.exists
// below is doing.
//
// Everything outside library/ is closed, so a signed-in account cannot use the project's storage for anything
// else.

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }
    function mayReadLibrary() {
      return isAdmin() || (signedIn() && firestore.exists(/databases/(default)/documents/testers/$(request.auth.uid)));
    }

    match /library/{allPaths=**} {
      allow read: if mayReadLibrary();
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
